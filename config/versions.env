# versions.env —— 软件版本与 npm 源配置
#
# 用途：集中指定 nvm、Node.js 和 AI CLI 的安装版本，避免安装结果随远端
# 最新版本变化。setup.sh 会在执行前加载本文件，并将变量传给相关动作。
# 修改后可使用以下命令预览或执行：
#   ./setup.sh install --pick nodejs,claude --dry-run
#   ./setup.sh install --pick nodejs,claude
# 直接 source engine/lib/util.sh 时也会自动加载本文件。
#
# 版本锁定流程：修改或锁定版本前请先实查；确认后在对应行注释
# “锁定于 YYYY-MM-DD”。
#   npm view <pkg> version
#   curl -s https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+'

# —— 基础运行时 ——
# nvm：curl -s https://api.github.com/repos/nvm-sh/nvm/releases/latest | grep -oP '"tag_name":\s*"\K[^"]+'
NVM_VERSION=v0.40.1
# node LTS 主版本（满足 claude≥20 / codex≥18 / opencode≥18 / gemini≥20 / qwen≥22 / iflow≥20 的最低要求；如需切 20 单独改）
NODE_LTS_MAJOR=22
# 可选：填写完整版本（如 22.x.y）后优先使用；留空则取上述主版本下最新可用版本
NODE_VERSION=

# —— 大模型 CLI（固定版本，避免漂移）——
# npm view <pkg> version 取最新稳定版
CLAUDE_CODE_PKG=@anthropic-ai/claude-code
CLAUDE_CODE_VERSION=2.1.228

CODEX_PKG=@openai/codex
CODEX_VERSION=0.147.0

OPENCODE_PKG=opencode-ai       # 注意：npm 包名是 opencode-ai，不是 opencode
OPENCODE_VERSION=1.18.18       # 锁定于 2026-08-16：npm view opencode-ai version

GEMINI_PKG=@google/gemini-cli
GEMINI_VERSION=0.66.0          # 锁定于 2026-10-28：npm view @google/gemini-cli version

QWEN_CODE_PKG=@qwen-code/qwen-code
QWEN_CODE_VERSION=0.26.2       # 锁定于 2026-10-28：npm view @qwen-code/qwen-code version

COPILOT_PKG=@github/copilot
COPILOT_VERSION=1.0.105        # 锁定于 2026-10-28：npm view @github/copilot version

IFLOW_PKG=@iflow-ai/iflow-cli
IFLOW_VERSION=0.5.19           # 锁定于 2026-10-28：npm view @iflow-ai/iflow-cli version

# —— npm 镜像（国内可选；不需要可留空）——
# 实查：https://replicate.npmjs.com/ 或 npm view <pkg> version 走的就是这个 registry
# 常见候选：npmmirror（阿里，推荐） / tencent https://mirrors.cloud.tencent.com/npm/
NPM_REGISTRY=https://registry.npmmirror.com
# NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
