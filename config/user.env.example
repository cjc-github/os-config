# user.env.example —— 用户配置模板
#
# 用法：复制为实际配置文件后再修改；程序只会自动读取 config/user.env。
#   cp config/user.env.example config/user.env
#   editor config/user.env
#   ./setup.sh --dry-run
#   ./setup.sh
#
# user.env 是 shell 环境变量文件，变量会导出给安装和验证脚本。它是本机
# 配置，不应提交到仓库（config/user.env 已在 .gitignore 中忽略）。
# 不需要自定义时可以不创建 user.env，程序会使用各模块的默认值。

# —— APT 行为与国内镜像源 ——
# sys-base 具体安装哪些基础工具请编辑 config/base-tools.conf。
APT_UPGRADE=false            # true 才执行系统全量 apt upgrade；默认只安装所需包
# 默认清华源 TUNA：amd64/i386 → MIRROR_APT_URL；arm64/riscv64/ppc64el → MIRROR_APT_PORTS_URL
# 常见候选（选一个填）：
#   清华   https://mirrors.tuna.tsinghua.edu.cn/ubuntu
#   阿里云 https://mirrors.aliyun.com/ubuntu
#   中科大 https://mirrors.ustc.edu.cn/ubuntu
MIRROR_APT_URL=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
MIRROR_APT_PORTS_URL=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
MIRROR_SKIP_APT=false        # true 跳过 apt 源重写（公司内网/空气隔离环境已自备源时用）
MIRROR_SKIP_APT_UPDATE=false # true 不执行 apt update（完全离线）

# —— 代理（默认启用配置；本仓库不会安装代理软件）——
PROXY_ENABLED=true           # false 可显式关闭 shell/Git 代理配置
PROXY_HOST=                  # 留空：当前 IPv4 最后一段替换为 1
PROXY_PORT=                  # 留空：默认使用 7890
PROXY_TEST_URL=https://github.com # curl -x 的真实访问验证地址
PROXY_CONNECT_TIMEOUT=5      # curl 连接超时，单位秒
PROXY_MAX_TIME=15            # curl 整体请求超时，单位秒
NO_PROXY=localhost,127.0.0.1,::1

GIT_USER_NAME=               # 留空：warning 后跳过，并提示 git config --global user.name 命令
GIT_USER_EMAIL=              # 留空：warning 后跳过，并提示 git config --global user.email 命令

SSH_INSTALL_SERVER=false   # true 才安装并验证 openssh-server；默认仅客户端
SSH_KEY_TYPE=ed25519        # 默认非交互生成 ed25519
SSH_KEY_PASSPHRASE=         # 留空 = 无 passphrase；注意 user.env 是明文文件

# 日志模块：journald 持久化目录上限（覆盖默认 SystemMaxUse）
JOURNALD_MAX_USE=200M
