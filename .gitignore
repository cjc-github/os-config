# ---------------------------------------------------------------------------
# os-config .gitignore
# ---------------------------------------------------------------------------

# 运行日志（engine/lib/log.sh 写入 logs/setup-*.log）
logs/
*.log

# npm 安装产物（npm 后端的全局/本地安装可能产生）
node_modules/
**/node_modules/
*/node_modules/

# 运行状态（engine/lib/state.sh 写入 manifest.conf 与 actions/<name>/ 持久备份）
state/
state/actions/

# 备份文件（engine/lib/rollback.sh 写入 *.bak.<timestamp>.<pid>）
*.bak
*.bak.*

# 用户私有配置（敏感信息：代理、token、个人偏好等，不进版本库）
config/user.env
config/ui.env
config/*.local.env
*.local.env

# Web UI 运行时（ui.sh 写入 state/ui/server.log 与每次运行记录）
state/ui/

# Python 缓存（ui/*.py 编译产物）
__pycache__/
*.pyc

# 临时/中转文件
*.tmp
*.tmp.*
.*-*

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统 / OS 杂项
.DS_Store
Thumbs.db

# Bash / shell 历史
.bash_history
.sh_history
