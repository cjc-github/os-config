# ===========================================================================
# base.catalog —— 基础软件工具目录（跨平台声明式数据层）
# ===========================================================================
#
# 每个 [工具标识] 段描述一个可安装项目。字段：
#
#   type      = package | config      （package=包管理器安装；config=脚本动作）
#   backend   = apt | npm | snap   （仅 package 必填）
#   packages  = 后端软件包（空格分隔；apt 可多个）
#   version   = 版本号（可写 $VAR，从 config/versions.env 展开；可留空）
#   commands  = 安装后应存在的验证命令（空格分隔）
#   track     = pin | latest          （pin=锁定 version；latest=跟随最新）
#   deps      = 依赖的工具标识（逗号分隔）
#   desc      = 一句话说明
#   group     = 分组名（供 --list 归类显示）
#
# 平台相关字段（可选；Windows 引擎 setup.ps1 读取，Bash 引擎忽略其内容）：
#
#   platforms      = linux | win | linux,win   （缺省 linux）
#   win_backend    = winget | npm              （platforms 含 win 且 backend 非 npm 时必填）
#   win_packages   = winget 包 id（空格分隔；与 apt 包名不同，必须单独声明）
#   win_commands   = Windows 上的验证命令（缺省回落 commands）
#
# 约束：工具标识只允许小写字母、数字、下划线、连字符。
# 用户通常只需要改 profiles/*.conf 选择工具，不需要改本文件。
# ===========================================================================

# --- 核心依赖 -------------------------------------------------------------
# Windows 上 CA 根证书由系统自带，用 win_backend=builtin 表示「无需安装」。
[ca-certificates]
type=package
backend=apt
packages=ca-certificates
commands=
track=latest
deps=
platforms=linux,win
win_backend=builtin
desc=HTTPS CA 根证书
group=core

[curl]
type=package
backend=apt
packages=curl
commands=curl
track=latest
deps=ca-certificates
platforms=linux,win
win_backend=builtin
win_commands=curl
desc=HTTP/HTTPS 命令行客户端
group=core

[wget]
type=package
backend=apt
packages=wget
commands=wget
track=latest
deps=ca-certificates
platforms=linux,win
win_backend=winget
win_packages=JernejSimoncic.Wget
win_commands=wget
desc=文件下载工具
group=core

[gnupg]
type=package
backend=apt
packages=gnupg
commands=gpg
track=latest
deps=
platforms=linux,win
win_backend=winget
win_packages=GnuPG.GnuPG
win_commands=gpg
desc=GPG 密钥与签名工具
group=core

# --- 文件传输 -------------------------------------------------------------
[lrzsz]
type=package
backend=apt
packages=lrzsz
commands=rz
track=latest
deps=
desc=ZMODEM rz/sz 文件传输
group=transfer

[rsync]
type=package
backend=apt
packages=rsync
commands=rsync
track=latest
deps=
desc=增量文件同步
group=transfer

# --- 压缩解压 -------------------------------------------------------------
# zip / unzip 只有 Linux 一条：Windows 不内置这两个命令（winget 里也没有提供
# zip CLI 的干净包），曾把它们标成 platforms=linux,win + win_backend=builtin，
# 结果是 install 谎称"系统自带，无需安装"、verify 又永远找不到命令而无法收敛。
# Windows 上归档由 [7zip]（winget）与系统自带 tar.exe 覆盖，故此处不声明 win。
[zip]
type=package
backend=apt
packages=zip
commands=zip
track=latest
deps=
desc=ZIP 压缩
group=archive

[unzip]
type=package
backend=apt
packages=unzip
commands=unzip
track=latest
deps=
desc=ZIP 解压
group=archive

[tar]
type=package
backend=apt
packages=tar
commands=tar
track=latest
deps=
desc=TAR 归档
group=archive

[gzip]
type=package
backend=apt
packages=gzip
commands=gzip
track=latest
deps=
desc=GZIP 压缩解压
group=archive

[bzip2]
type=package
backend=apt
packages=bzip2
commands=bzip2
track=latest
deps=
desc=BZIP2 压缩解压
group=archive

[xz]
type=package
backend=apt
packages=xz-utils
commands=xz
track=latest
deps=
desc=XZ 压缩解压
group=archive

[7zip]
type=package
backend=apt
packages=7zip
commands=7z
track=latest
deps=
platforms=linux,win
win_backend=winget
win_packages=7zip.7zip
win_commands=7z
desc=7-Zip 压缩解压
group=archive

[unrar-free]
type=package
backend=apt
packages=unrar-free
commands=unrar-free
track=latest
deps=
desc=RAR 解压（自由实现）
group=archive

# --- 网络诊断 -------------------------------------------------------------
# ping / net-tools / dnsutils / traceroute 在 Windows 上由系统命令提供，
# 用 win_backend=builtin 表示「系统自带，无需安装」，win_commands 换成 Windows 命令名。
[ping]
type=package
backend=apt
packages=iputils-ping
commands=ping
track=latest
deps=
platforms=linux,win
win_backend=builtin
win_commands=ping
desc=网络连通性检查
group=network

[dnsutils]
type=package
backend=apt
packages=dnsutils
commands=dig
track=latest
deps=
platforms=linux,win
win_backend=builtin
win_commands=nslookup
desc=DNS 查询与诊断
group=network

[net-tools]
type=package
backend=apt
packages=net-tools
commands=netstat
track=latest
deps=
platforms=linux,win
win_backend=builtin
win_commands=netstat
desc=传统网络诊断命令
group=network

[traceroute]
type=package
backend=apt
packages=traceroute
commands=traceroute
track=latest
deps=
platforms=linux,win
win_backend=builtin
win_commands=tracert
desc=路由追踪
group=network

[tcpdump]
type=package
backend=apt
packages=tcpdump
commands=tcpdump
track=latest
deps=
desc=网络抓包
group=network

[telnet]
type=package
backend=apt
packages=telnet
commands=telnet
track=latest
deps=
desc=TCP 端口连通测试
group=network

[aria2]
type=package
backend=apt
packages=aria2
commands=aria2c
track=latest
deps=
desc=多协议下载工具
group=network

