# ===========================================================================
# base.catalog —— 基础软件工具目录（跨平台声明式数据层）
# ===========================================================================
#
# 每个 [工具标识] 段描述一个可安装项目。字段：
#
#   type      = package | config      （package=包管理器安装；config=脚本动作）
#   backend   = apt | npm | snap   （仅 package 必填）
#   packages  = 后端软件包（空格分隔；apt 可多个）
#   version   = 版本号（可写 $VAR，从 config/versions.env 展开；可留空）
#   commands  = 安装后应存在的验证命令（空格分隔）
#   track     = pin | latest          （pin=锁定 version；latest=跟随最新）
#   deps      = 依赖的工具标识（逗号分隔）
#   desc      = 一句话说明
#   group     = 分组名（供 --list 归类显示）
#
# 约束：工具标识只允许小写字母、数字、下划线、连字符。
# 用户通常只需要改 profiles/*.conf 选择工具，不需要改本文件。
# ===========================================================================

# --- 核心依赖 -------------------------------------------------------------
[ca-certificates]
type=package
backend=apt
packages=ca-certificates
commands=
track=latest
deps=
desc=HTTPS CA 根证书
group=core

[curl]
type=package
backend=apt
packages=curl
commands=curl
track=latest
deps=ca-certificates
desc=HTTP/HTTPS 命令行客户端
group=core

[wget]
type=package
backend=apt
packages=wget
commands=wget
track=latest
deps=ca-certificates
desc=文件下载工具
group=core

[gnupg]
type=package
backend=apt
packages=gnupg
commands=gpg
track=latest
deps=
desc=GPG 密钥与签名工具
group=core

# --- 文件传输 -------------------------------------------------------------
[lrzsz]
type=package
backend=apt
packages=lrzsz
commands=rz
track=latest
deps=
desc=ZMODEM rz/sz 文件传输
group=transfer

[rsync]
type=package
backend=apt
packages=rsync
commands=rsync
track=latest
deps=
desc=增量文件同步
group=transfer

