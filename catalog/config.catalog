# ===========================================================================
# config.catalog —— 基础工具包 + 配置类工具目录
# ===========================================================================
#
# 这里同时放两类条目：
#
#   type=package  「配置动作依赖的包」——例如 git、openssh-client、日志三件套。
#                 它们由包管理器安装/卸载，因此拆成独立条目，remove 时才能
#                 按依赖图逆序正确 apt remove。
#
#   type=config   真正写入配置的动作：apply（写入）/ remove（还原）/ verify（校验）。
#                 action     = 动作名（对应 engine/actions/<action>.sh）
#                 artifacts  = 该动作写入的产物路径（空格分隔，支持 ~ 和 $VAR）；
#                              引擎据此记录 state/manifest 并在 remove 时清理
#                 sudo       = 0 | 1（是否需要提权）
#
# 配置动作的依赖统一用 deps 声明，例如 [git] deps=git-cli。
# ===========================================================================

# --- 配置动作依赖的软件包 -------------------------------------------------
[git-cli]
type=package
backend=apt
packages=git
commands=git
track=latest
deps=
platforms=linux,win
win_backend=winget
win_packages=Git.Git
win_commands=git
desc=Git 版本控制
group=config

# Windows 10 1809+ 自带 OpenSSH 客户端（System32\OpenSSH\ssh.exe），无需安装。
[openssh-client]
type=package
backend=apt
packages=openssh-client
commands=ssh
track=latest
deps=
platforms=linux,win
win_backend=builtin
win_commands=ssh
desc=OpenSSH 客户端
group=config

[openssh-server]
type=package
backend=apt
packages=openssh-server
commands=sshd
track=latest
deps=openssh-client
desc=OpenSSH 服务端（默认不选；用 --pick openssh-server 或写进 profile 启用）
group=config

[log-tools]
type=package
backend=apt
packages=lnav bat logrotate
commands=lnav batcat logrotate
track=latest
deps=
desc=日志查看与轮转工具（lnav/bat/logrotate）
group=config

# --- 配置动作 -------------------------------------------------------------
# 平台说明：mirrors / syslog / nosuspend 仅适用于 Linux（APT 源、journald、GNOME），
# 未声明 platforms 即默认 linux，Windows 引擎会自动跳过并给出提示。
[mirrors]
type=config
action=mirrors
artifacts=/etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list
sudo=1
track=latest
deps=
desc=切换 APT 镜像源为国内加速源
group=config

[proxy]
type=config
action=proxy
artifacts=~/.bashrc
win_artifacts=${PSPROFILE}
sudo=0
track=latest
deps=
platforms=linux,win
desc=推导代理地址并写入 shell 代理环境变量
group=config

[git]
type=config
action=git
artifacts=~/.gitconfig ~/.config/git/config
sudo=0
track=latest
deps=git-cli
platforms=linux,win
desc=配置 git 身份与代理
group=config

[ssh]
type=config
action=ssh
artifacts=~/.ssh
sudo=0
track=latest
deps=openssh-client
platforms=linux,win
desc=生成 SSH 用户密钥
group=config

[syslog]
type=config
action=syslog
artifacts=/etc/systemd/journald.conf.d/99-os-config.conf ~/.bashrc ~/.local/bin/bat
sudo=1
track=latest
deps=log-tools
desc=journald 限容与 oslogs 别名
group=config

[nosuspend]
type=config
action=nosuspend
artifacts=
sudo=0
track=latest
deps=
desc=关闭桌面息屏与自动锁屏
group=config

# Windows 上由 engine/actions-win/nodejs.ps1 实现：经 winget 装 fnm，
# 用 fnm 管理 Node 版本（保留 NODE_VERSION 精确 pin 语义且免管理员）。
# ${PSPROFILE} 由 Windows 引擎解析为 $PROFILE.CurrentUserCurrentHost，
# 以避免 Documents 被 OneDrive 重定向时 catalog 里写死的路径对不上。
[nodejs]
type=config
action=nodejs
artifacts=~/.nvm ~/.npmrc
win_artifacts=${HOME}\AppData\Roaming\fnm\node-versions ${HOME}\.npmrc ${PSPROFILE}
sudo=0
track=latest
deps=curl
platforms=linux,win
desc=通过版本管理器安装 Node LTS 并配置 npm 镜像
group=runtime

# --- AI 编码 CLI（npm 全局包） --------------------------------------------
# npm 在 Windows 上原生可用，因此三条只需声明 platforms=linux,win，
# 不需要 win_backend / win_packages。
[claude]
type=package
backend=npm
packages=${CLAUDE_CODE_PKG:-@anthropic-ai/claude-code}
version=$CLAUDE_CODE_VERSION
commands=claude
track=pin
deps=nodejs
platforms=linux,win
desc=Claude Code CLI
group=ai

[codex]
type=package
backend=npm
packages=${CODEX_PKG:-@openai/codex}
version=$CODEX_VERSION
commands=codex
track=pin
deps=nodejs
platforms=linux,win
desc=OpenAI Codex CLI
group=ai

[opencode]
type=package
backend=npm
packages=${OPENCODE_PKG:-opencode-ai}
version=$OPENCODE_VERSION
commands=opencode
track=pin
deps=nodejs
platforms=linux,win
desc=OpenCode CLI
group=ai

[gemini]
type=package
backend=npm
packages=${GEMINI_PKG:-@google/gemini-cli}
version=$GEMINI_VERSION
commands=gemini
track=pin
deps=nodejs
platforms=linux,win
desc=Google Gemini CLI
group=ai

[qwen]
type=package
backend=npm
packages=${QWEN_CODE_PKG:-@qwen-code/qwen-code}
version=$QWEN_CODE_VERSION
commands=qwen
track=pin
deps=nodejs
platforms=linux,win
desc=阿里 Qwen Code CLI
group=ai

[copilot]
type=package
backend=npm
packages=${COPILOT_PKG:-@github/copilot}
version=$COPILOT_VERSION
commands=copilot
track=pin
deps=nodejs
platforms=linux,win
desc=GitHub Copilot CLI
group=ai

[iflow]
type=package
backend=npm
packages=${IFLOW_PKG:-@iflow-ai/iflow-cli}
version=$IFLOW_VERSION
commands=iflow
track=pin
deps=nodejs
platforms=linux,win
desc=iFlow CLI（心流）
group=ai
